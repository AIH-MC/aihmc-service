# 忽略 RSA 密钥文件
keys/private.pem
keys/public.key

# 忽略 Python 缓存和环境
__pycache__/
*.pyc
.venv/
.env

# 忽略皮肤缓存
textures/*
!textures/.keep

#忽略生产环境配置文件
config.yml
config.toml
legacy/python/keys/private.pem
legacy/python/keys/public.key
legacy/python/textures/*
!legacy/python/textures/.keep

# Local migration tools and verification output
.codegraph/
build.log
test-output/
target/
